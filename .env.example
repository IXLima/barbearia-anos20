PORT=3000
NODE_ENV=development
SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Conta administrativa (entrada em /admin-login).
# Com ADMIN_PASSWORD (mínimo 8 caracteres) a conta é criada ou atualizada a cada inicialização.
# Sem ADMIN_PASSWORD, apenas uma conta Google com este e-mail vira administradora.
# Alternativa: rode "npm run criar-admin".
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: pasta onde ficam users.json, agendamentos.json e bloqueios.json.
# DATA_DIR=
